<style>
  .btn-search{
    color: #002f34 !important;
  border-color: rgb(216, 212, 212) !important;
  font-weight: 900 !important;
  }

  .btn-search:hover {
  color: white !important;
  background-color: #002f34 !important;
}
</style>

<nav class="navbar navbar-expand-md bg-body-tertiary sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/items"
      >QuickBuy<i class="fa-solid fa-truck-fast"></i></i
    ></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <input id="location-input" class="form-control" type="text" placeholder="Enter City" />
        </div>  

<div class="navbar-nav ms-2">
  <form class="d-flex" role="search"  method="POST" action="/items/search">
    <input class="form-control me-2" name="search" type="search" placeholder="Search" aria-label="Search">
    <input type="hidden" name="location" id="location-hidden">
    <button class="btn btn-search" type="submit">Search</button>
  </form>
</div>

      <div class="navbar-nav ms-auto">
        <% if(!currUser) { %>
        <a class="nav-link" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>
        <% if(currUser) { %>
          <a class="nav-link" href="#">Message</a>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
        <a class="nav-link" href="/items/item"
          ><i class="fa-solid fa-plus"></i><b></b> Sell</b></a
        >
        </div>

    </div>
  </div>
  <script>
    const locationInput = document.getElementById('location-input');
    const locationHidden = document.getElementById('location-hidden');
  
    // Set initial location on page load
    window.onload = () => {
      const savedLocation = localStorage.getItem('userLocation') || 'Delhi';
      locationInput.value = savedLocation;
      locationHidden.value = savedLocation;
    };
  
    // Save to localStorage and update hidden input when user updates location
    locationInput.addEventListener('blur', () => {
      const city = locationInput.value.trim();
      if (city) {
        localStorage.setItem('userLocation', city);
        locationHidden.value = city;
      }
    });
  
    // Optional: update hidden input again on form submit (if JS loads late)
    document.getElementById('search-form')?.addEventListener('submit', function () {
      const city = locationInput.value.trim() || 'Delhi';
      locationHidden.value = city;
      localStorage.setItem('userLocation', city);
    });
  </script>
  
  
</nav>

