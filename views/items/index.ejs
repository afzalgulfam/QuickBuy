<% layout("/layouts/boilerplate.ejs",{showNavbar:true}) %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
  }

  .filter {
    text-align: center;
    margin-right: 4.1rem;
    margin-top: 2rem;
    opacity: 0.7;
  }

  .filter p {
    font-size: 0.8rem;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
</style>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-car"></i></div>
    <p>Cars</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-motorcycle"></i></div>
    <p>Motorcycles</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-shirt"></i></div>
    <p>Fashion</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-desktop"></i></div>
    <p>Laptops</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-camera"></i></div>
    <p>Camera</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tv"></i></div>
    <p>TVs</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bicycle"></i></div>
    <p>Bicycle</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-couch"></i></div>
    <p>Furniture</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-hard-drive"></i></div>
    <p>Hard Disk</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-fan"></i></div>
    <p>ACs</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-gamepad"></i></div>
    <p>Games</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-print"></i></div>
    <p>Printers</p>
  </div>
</div>

<div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 mt-3">
  <% let mobileIndex = 0; let carIndex = 0; while (mobileIndex <
  allMobile.length || carIndex < allCar.length) { for (let i = 0; i < 4 &&
  mobileIndex < allMobile.length; i++) { let mobile = allMobile[mobileIndex++];
  %>
  <a href="/items/mobile/<%= mobile._id %>" class="item-link">
    <div class="card col" style="width: 20rem">
      <img
        src="<%= mobile.image %>"
        class="card-image"
        alt="item_image"
        style="height: 12rem"
      />
      <div class="card-body">
        <h3 class="item-title index-price">
          &#8377; <%=mobile.price.toLocaleString("en-IN")%>
        </h3>
        <p class="card-text">
          <label class="show-description blur"><%= mobile.title %></label><br />
          <% if(mobile.brand){%>
          <label><b> <%=mobile.brand%></b></label
          ><br />
          <%}%><% if(!mobile.brand){%>
          <label>&nbsp;&nbsp;&nbsp;</label><br />
          <%}%>
          <label class="size blur"
            ><%= mobile.neighbourhood %>,&nbsp;<%=mobile.city%></label
          >
        </p>
      </div>
    </div>
  </a>
  <% } for (let i = 0; i < 4 && carIndex < allCar.length; i++) { let car =
  allCar[carIndex++]; %>
  <a href="/items/car/<%= car._id %>" class="item-link">
    <div class="card col" style="width: 20rem">
      <img
        src="<%= car.image %>"
        class="card-image"
        alt="item_image"
        style="height: 12rem"
      />
      <div class="card-body">
        <h3 class="item-title index-price">
          &#8377; <%=car.price.toLocaleString("en-IN")%>
        </h3>
        <p class="card-text">
          <%= car.year %> - <%= car.driven.toLocaleString("en-IN") %> Km
          <br />
          <label><b><%= car.brand %>&nbsp;<%= car.model %></b></label
          ><br />
          <label class="size blur"
            ><%= car.neighbourhood %>,&nbsp;<%=car.city%></label
          >
        </p>
      </div>
    </div>
  </a>
  <% } } %>
</div>
