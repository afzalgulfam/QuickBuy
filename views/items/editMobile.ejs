<% layout("/layouts/boilerplate.ejs") %>
<style>
  .navbar {
    display: none;
  }
</style>
<body>
  <div class="back sticky-top"></div>
  <h4>POST YOUR AD</h4>
  <div class="centre">
    <div class="row item-info">
      <div class="hr"></div>
      <b class="include">INCLUDE SOME DETAILS</b><br />
      <span class="input">
        <form
          method="POST"
          action="/items/mobiles/<%=mobile._id%>?_method=PUT"
          novalidate
          class="needs-validation"
        >
          <input
            type="hidden"
            name="mobile[category]"
            value="<%=mobile.category%>"
          />
          <% if(mobile.category=="Mobile phones" || mobile.category=="Tablets"
          || mobile.category=="Bicycles"){ %>
          <div class="mb-3">
            <label for="brand" class="form-label">Brand *</label>
            <input
              name="mobile[brand]"
              value="<%=mobile.brand %>"
              class="form-control"
              type="text"
              required
            />
            <div class="invalid-feedback size">
              Brand is mandatory. Please complete the required field.
            </div>
          </div>
          <% } %>
          <div class="mb-3">
            <label for="title" class="form-label">Ad title *</label>
            <input
              name="mobile[title]"
              value="<%=mobile.title %>"
              class="form-control"
              type="text"
              required
            />
            <label class="size"
              >Mention the key features of your item (e.g. brand, model,
              age,type)</label
            >
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">Description *</label>
            <textarea
              name="mobile[description]"
              class="form-control"
              rows="4"
              required
            >
<%=mobile.description %></textarea
            >
            <label class="size"
              >Include condition, features and reason for selling</label
            >
          </div>
          <div class="mb-3">
            <label for="price" class="form-label">Price *</label>
            <input
              name="mobile[price]"
              value="<%=mobile.price %>"
              class="form-control"
              type="number"
              required
            />
            <div class="invalid-feedback size">This field is mandatory</div>
          </div>
          <div class="mb-3">
            <label for="image" class="form-label">Image *</label>
            <input
              name="mobile[image]"
              value="<%=mobile.image %>"
              class="form-control"
              type="text"
            />
            <label class="size validate">This field is mandatory</label>
          </div>
          <div class="mb-3">
            <label for="location" class="form-label">Neighbourhood *</label>
            <input
              name="mobile[neighbourhood]"
              value="<%=mobile.neighbourhood %>"
              class="form-control"
              type="text"
              required
            />
          </div>
          <div class="mb-3">
            <label for="city" class="form-label">City *</label>
            <input
              name="mobile[city]"
              value="<%=mobile.city %>"
              class="form-control"
              type="text"
              required
            />
          </div>
          <div class="mb-3">
            <label for="state" class="form-label">State </label>
            <input
              name="mobile[state]"
              value="<%=mobile.state %>"
              class="form-control"
              type="text"
            />
            <label class="size validate">This field is mandatory</label>
          </div>
          <button class="btn btn-post mb-3">Post Now</button>
        </form>
      </span>
    </div>
  </div>
</body>
